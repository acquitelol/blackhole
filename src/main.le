use std/prelude;
use std/raylib;
use shader;

let SCALE = 1;
let WIDTH = 1280;
let HEIGHT = 800;

fn main() {
	rl::init_window(WIDTH, HEIGHT, "Black Hole");
	defer rl::close_window();

	camera := Camera3D {
		position = Vector3::new(0, -2, 20),
		target = Vector3::new(0, 0, 0),
		up = Vector3::new(0, 1, 0),
		fovy = 70.0,
		projection = CameraProjection::CAMERA_PERSPECTIVE,
	};

	galaxy := rl::load_image("assets/milkyway.jpg");
	rl::image_resize(&galaxy, WIDTH * SCALE, HEIGHT * SCALE);
	texture := rl::load_texture_from_image(galaxy);
	rl::set_texture_filter(texture, TextureFilter::TEXTURE_FILTER_TRILINEAR);

	target := rl::load_render_texture(WIDTH * SCALE, HEIGHT * SCALE);

	shader := rl::load_shader(nil, "src/blackhole.fs");
	shader.set_value("resolution", &Vector2::new(WIDTH * SCALE, HEIGHT * SCALE));
	shader.set_value("camTarget", &camera.target);
	shader.set_value("camUp", &camera.up);
	rl::set_target_fps(60);

	//frames := []Image;
	//frame := 0;

	//while frame < math::round(2 * PI / 0.5 * 60) + 2 {
	while !rl::window_should_close() {
		mode := rl::is_mouse_button_down(MouseButton::MOUSE_BUTTON_RIGHT)
			? CameraMode::CAMERA_THIRD_PERSON
			: CameraMode::CAMERA_ORBITAL;
		rl::update_camera(#cast(Camera *, &camera), mode);
		shader.set_value("camPos", &camera.position);

		//$dbg(camera.position);
		rl::begin_texture_mode(target);
		rl::begin_shader_mode(shader);
		rl::draw_texture(texture, 0, 0, WHITE);
		rl::end_shader_mode();
		rl::end_texture_mode();

		rl::begin_drawing();
		rl::draw_texture_pro(
			target.texture,
			Rectangle {
				x = 0, y = 0,
				width = WIDTH * SCALE,
				height = -HEIGHT * SCALE
			},
			Rectangle {
				x = 0, y = 0,
				width = WIDTH,
				height = HEIGHT
			},
			Vector2::zero(), 0, WHITE
		);
		rl::draw_fps(10, 10);
		rl::end_drawing();

		//if frame > 2 {
		//	image := rl::load_image_from_texture(target.texture);
		//	frames.push(image);
		//}

		//frame += 1;
	}

	//for i, image in frames.iter().enumerate() {
	//	rl::image_flip_vertical(&image);
	//	rl::export_image(image, "output/{}.png".format(i));
	//}

	//libc::system("yes | ffmpeg -framerate 60 -i output/%d.png -vf \"palettegen\" palette.png");
	//libc::system("yes | ffmpeg -framerate 60 -i output/%d.png -i palette.png -lavfi \"paletteuse\" out.gif");
}