use std/prelude;
use std/raylib;
use shader;

let WIDTH = 1080;
let HEIGHT = 720;
let EVENT_HORIZON = 48.0;

fn main() {
	rl::init_window(WIDTH, HEIGHT, "Black Hole");
	defer rl::close_window();

	blackhole := Vector2::new(WIDTH, HEIGHT).scale(0.5);
	galaxy := rl::load_image("assets/milkyway.jpg");
	rl::image_resize(&galaxy, WIDTH, HEIGHT);

	texture := rl::load_texture_from_image(galaxy);
	shader := rl::load_shader(nil, "src/blackhole.fs");

	shader.set_value("resolution", &blackhole.scale(2));
	shader.set_value("eventHorizon", &EVENT_HORIZON);
	shader.set_value("blackhole", &blackhole);
	rl::set_target_fps(60);

	while !rl::window_should_close() {
		if rl::is_mouse_button_down(MouseButton::MOUSE_BUTTON_LEFT) {
			blackhole = rl::get_mouse_position();
			shader.set_value("blackhole", &blackhole);
		}

		rl::begin_drawing();
		rl::clear_background(BLACK);

		rl::begin_shader_mode(shader);
		rl::draw_texture(texture, 0, 0, WHITE);
		rl::end_shader_mode();

		rl::draw_circle_lines_v(blackhole, EVENT_HORIZON, DARKGRAY);
		rl::draw_fps(10, 10);
		rl::end_drawing();
	}
}