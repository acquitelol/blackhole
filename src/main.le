use std/prelude;
use std/raylib;

let WIDTH = 1080;
let HEIGHT = 720;
let EVENT_RADIUS = 48.0;

fn main() {
	rl::init_window(WIDTH, HEIGHT, "Black Hole");
	defer rl::close_window();

	blackhole := Vector2::new(WIDTH, HEIGHT).scale(0.5);
	galaxy := rl::load_image("assets/milkyway.jpg");
	rl::image_resize(&galaxy, WIDTH, HEIGHT);

	texture := rl::load_texture_from_image(galaxy);

	lens_shader := rl::load_shader(nil, "src/blackhole.fs");
	blackhole_loc  := rl::get_shader_location(lens_shader, "blackhole");
	resolution_loc := rl::get_shader_location(lens_shader, "resolution");

	rl::set_shader_value(lens_shader, resolution_loc, &blackhole.scale(2).x, ShaderUniformDataType::SHADER_UNIFORM_VEC2);
	rl::set_target_fps(60);

	while !rl::window_should_close() {
		if rl::is_mouse_button_down(MouseButton::MOUSE_BUTTON_LEFT) {
			blackhole = rl::get_mouse_position();
		}

		rl::set_shader_value(lens_shader, blackhole_loc, &blackhole.x, ShaderUniformDataType::SHADER_UNIFORM_VEC2);

		rl::begin_drawing();
		rl::clear_background(BLACK);

		rl::begin_shader_mode(lens_shader);
		rl::draw_texture(texture, 0, 0, WHITE);
		rl::end_shader_mode();

		rl::draw_circle_v(blackhole, EVENT_RADIUS, BLACK);
		rl::draw_circle_lines_v(blackhole, EVENT_RADIUS + 2, DARKGRAY);
		rl::draw_fps(10, 10);
		rl::end_drawing();
	}
}